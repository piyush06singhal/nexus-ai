# =============================================================================
# NEXUS — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env files to version control.
# =============================================================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL)
# NEXUS maps its Postgres to host port 5433 to avoid colliding with a system
# Postgres on 5432. Set POSTGRES_PORT to change the host-side mapping.
DATABASE_URL=postgresql+psycopg://nexus:nexus_dev@localhost:5433/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev
POSTGRES_DB=nexus
POSTGRES_PORT=5433

# Redis
REDIS_URL=redis://localhost:6379/0

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Providers (Phase 1+)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
