# =============================================================================
# NEXUS — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env files to version control.
#
# NOTE: Docker is the canonical setup path — `docker compose up --build`
# requires no Python/Node on the host. Local (host) dev requires Python >= 3.14
# for the backend (scripts/setup.sh enforces this). No API keys are required
# anywhere; the bundled MockProvider drives the whole stack deterministically.
# =============================================================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL)
# NEXUS maps its Postgres to host port 5433 to avoid colliding with a system
# Postgres on 5432. Set POSTGRES_PORT to change the host-side mapping.
DATABASE_URL=postgresql+psycopg://nexus:nexus_dev@localhost:5433/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev
POSTGRES_DB=nexus
POSTGRES_PORT=5433

# ── Docker auto-migration ──────────────────────────────────────────────────
# The API container entrypoint (infrastructure/docker/docker-entrypoint.sh)
# runs `alembic upgrade head` on startup by default. Set AUTO_MIGRATE=false
# to skip migrations inside the container (e.g. when managing migrations
# manually or running in a read-only root filesystem).
# AUTO_MIGRATE=true

# Redis
REDIS_URL=redis://localhost:6379/0

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Frontend (the web app reads API_BASE_URL from apps/web/.env.local; see
# apps/web/.env.example). Leave unset here — the web rewrite targets the API
# service in Docker and http://localhost:8000 in local dev by default.
# API_BASE_URL=http://localhost:8000

# Multi-Agent Orchestration (Phase 5)
# Run orchestrations inline (true in the test suite) vs. a worker.
ORCHESTRATION_EXECUTE_SYNC=false
# Daemon worker threads that drain QUEUED workflow executions and CREATED
# orchestration runs off the request path. Off by default (dev/test runs inline);
# the deploy overlay and scripts/run_production.sh turn them on.
WORKFLOW_WORKER_ENABLED=false
ORCHESTRATION_WORKER_ENABLED=false
ORCHESTRATION_DEFAULT_STRATEGY=deterministic
# Resource limits (per orchestration)
ORCHESTRATION_MAX_AGENTS=20
ORCHESTRATION_MAX_TASKS=50
ORCHESTRATION_MAX_PARALLEL_AGENTS=5
ORCHESTRATION_MAX_PARALLEL_TASKS=5
ORCHESTRATION_MAX_EXECUTION_DURATION_SECONDS=3600
ORCHESTRATION_MAX_EXECUTION_ITERATIONS=100
ORCHESTRATION_MAX_MESSAGES_PER_ORCHESTRATION=500
ORCHESTRATION_MAX_REVIEW_ITERATIONS=3
ORCHESTRATION_CONFLICT_NUMERIC_THRESHOLD=0.2
ORCHESTRATION_MEMORY_NAMESPACE=orchestration

# Verification, Recovery & Evaluation (Phase 6)
# Run verification/recovery inline (true in the test suite) vs. deferred.
VERIFICATION_ENABLED=false
RECOVERY_ENABLED=false
RECOVERY_EXECUTE_SYNC=false
# Recovery budgets (JSON): max_retries, max_verification_attempts, max_runtime_seconds,
# max_tokens, max_cost, tool_call_budget
RECOVERY_EXECUTION_BUDGET_JSON={"max_retries":2,"max_verification_attempts":2}
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_RETRY_BASE_DELAY_MS=0
# Evaluation / regression detection
EVALUATION_REGRESSION_THRESHOLD=0.05
ESCALATION_AUTO_APPROVE=false
# Failure injection is TEST-ONLY and gated off in production.
FAILURE_INJECTION_ENABLED=false

# AI Employee OS (Phase 7)
EMPLOYEE_DEFAULT_CAPACITY=5
EMPLOYEE_MAX_CONCURRENT_TASKS=5
EMPLOYEE_BUDGET_DEFAULT_MONTHLY=50.0
EMPLOYEE_EVALUATION_ON_TASK_COMPLETE=false
EMPLOYEE_CONTEXT_MAX_TOKENS=4000
EMPLOYEE_AUDIT_ENABLED=true

# AI Providers
# The "mock" provider (the default) needs no key and returns deterministic
# output — every demo/test runs on it. OPENAI_API_KEY is OPTIONAL: when set,
# agents using provider="openai" make real Chat Completions calls (bounded
# retries, token-cost metrics); when unset, the OpenAI adapters silently
# fall back to deterministic output so nothing breaks. Set
# MEMORY_EMBEDDING_PROVIDER=openai to enable real semantic embeddings.
# OPENAI_API_KEY=sk-...                      # optional; your key, your metering
# OPENAI_BASE_URL=                           # empty -> https://api.openai.com/v1
# OPENAI_DEFAULT_MODEL=gpt-4o-mini           # agents may override model_name
# OPENAI_MAX_RETRIES=2
# OPENAI_RETRY_BACKOFF_SECONDS=1.0

# External Integrations & Computer Use (Phase 10)
# Every external action flows risk → policy → autonomy → approval → execution →
# verification → recovery → audit. Set to "false" only in guarded test/dev.
SSRF_PROTECTION_ENABLED=true
PROMPT_INJECTION_PROTECTION_ENABLED=true
# Capability tools register as Phase 2 tools; HIGH/CRITICAL are approval-gated.
# Outbound data-class ceiling (public|internal|confidential|restricted|secret).
EXTERNAL_OUTBOUND_CLASS=confidential
# Generic HTTP connector is OFF by default (§14) — opt in per deployment + policy.
EXTERNAL_GENERIC_HTTP_CONNECTOR_ENABLED=false
# Timeouts / caps (bounded defaults; raise only with intent).
EXTERNAL_ACTION_TIMEOUT_SECONDS=60
EXTERNAL_CONNECT_TIMEOUT_SECONDS=10
EXTERNAL_READ_TIMEOUT_SECONDS=30
MAX_EXTERNAL_ACTIONS=500
MAX_BROWSER_SESSIONS=10
MAX_COMPUTER_SESSIONS=5
MAX_BROWSER_ACTIONS=200
MAX_COMPUTER_ACTIONS=100
MAX_BROWSER_SESSION_DURATION_MINUTES=30
MAX_COMPUTER_SESSION_DURATION_MINUTES=30
MAX_BROWSER_NAVIGATIONS=50
MAX_PAGE_SIZE_BYTES=4096
MAX_EXTERNAL_PAYLOAD_BYTES=16384
MAX_WEBHOOK_PAYLOAD_BYTES=16384
MAX_EXTERNAL_EVENTS=1000
EXTERNAL_RATE_LIMIT_PER_MINUTE=60
EXTERNAL_CIRCUIT_BREAKER_THRESHOLD=5
EXTERNAL_CIRCUIT_BREAKER_RESET_SECONDS=30
# External workspace root: empty ⇒ deterministic in-repo virtual workspace. A
# real path enables the sandboxed local workspace (path-containment enforced).
# EXTERNAL_WORKSPACE_ROOT=
# Signed webhooks: 32+ char operator secret. Empty ⇒ webhook ingress returns 503.
# EXTERNAL_WEBHOOK_HMAC_SECRET=

# ── Operator credential sources for connections (Phase 10, reference-only vault)
# Connection secrets are NEVER stored in the database. Resolve them at use-time
# from an env var named after the hint a connection records (case-insensitive):
# INTEGRATION_<PROVIDER>_SECRET / INTEGRATION_<PROVIDER>_API_KEY ...
# These are dev/demo conveniences only — a managed vault is a Phase 11 item.
# INTEGRATION_EMAIL_API_KEY=dev-secret-email
# INTEGRATION_EMAIL_SECRET=
# INTEGRATION_CALENDAR_API_KEY=
# INTEGRATION_DEVELOPMENT_API_KEY=
# INTEGRATION_WEB_RESEARCH_API_KEY=

# ══════════════════════════════════════════════════════════════════════════════
# Security, Governance & Production Hardening (Phase 11)
# ══════════════════════════════════════════════════════════════════════════════

# Authentication & sessions.
# Enable the auth middleware (bearer tokens) for /api/v1 EXCEPT the public
# whitelist. Production MUST set AUTH_ENABLED=true — production_readiness FAILs
# if it is false. Dev/test can stay open (existing tests run without auth).
AUTH_ENABLED=false
# Non-production bootstrap admin (empty ⇒ none). Created on first startup when
# no admin exists. NEVER set these in production deployments.
# AUTH_DEV_BOOTSTRAP_EMAIL=admin@nexus.local
# AUTH_DEV_BOOTSTRAP_PASSWORD=<change-me>
# HMAC key for signed bearer tokens (HS256). From env ONLY, never committed.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production (production_readiness FAILs if empty).
JWT_SECRET_KEY=
# AES-256-GCM (Fernet) key for secret ciphertext at rest. Also env-only.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production (production_readiness FAILs if empty).
SECRET_ENCRYPTION_KEY=
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
SECURE_AUTH_COOKIES=false

# API security surface
TRUSTED_HOSTS=["localhost","127.0.0.1"]
# MAX_REQUEST_BODY_BYTES=2000000
# Security headers appended by middleware unless already present.
# SECURITY_HEADERS={"X-Content-Type-Options":"nosniff","X-Frame-Options":"DENY"}
# Rate limiting
RATE_LIMIT_ENABLED=false
# Backend: "memory" = per-process in-memory sliding window (default, test suite);
# "redis" = cross-process ZSET window via REDIS_URL (degrades to memory on
# Redis outage — a Redis down never 500s the API). The deploy overlay sets redis.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_DEFAULT_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_EXTERNAL_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=30

# Governance: resource limits / runaway guard
# RESOURCE_MAX_ITERATIONS_DEFAULT=100
# RESOURCE_MAX_DURATION_SECONDS_DEFAULT=3600
# RESOURCE_MAX_TOKENS_DEFAULT=500000
# RESOURCE_MAX_COST_DEFAULT=500.0
# RESOURCE_MAX_TOOL_CALLS_DEFAULT=500

# Feature flags — risky capabilities default OFF (safe defaults)
FEATURE_FLAGS_ENABLED=true
FEATURE_SELF_SERVE_SIGNUP_ENABLED=false
FEATURE_PROFILE_IMPORT_ENABLED=false
FEATURE_BROWSER_CLOUD_EXPORT_ENABLED=false
FEATURE_EXTERNAL_AUTONOMOUS_SEND_ENABLED=false
FEATURE_DATA_EXPORT_ENABLED=false
FEATURE_CODE_EXECUTION_ENABLED=false

# Kill switch — global pause for autonomy across tenants
KILL_SWITCH_GLOBAL_PAUSE=false

# Retention windows (days).
RETENTION_EXECUTION_DAYS=180
RETENTION_LOGS_DAYS=180
# 0 ⇒ never auto-delete audit/security events.
RETENTION_SECURITY_EVENTS_DAYS=0

# Observability
LOGGING_JSON=false
# TLS_ENABLED=false  # upstream-terminated TLS implies true; cookie/header hints

# Approval governance (composes Phase 9 ApprovalGateManager)
APPROVAL_REQUIRE_SEPARATION_OF_DUTIES=true
APPROVAL_SELF_APPROVAL_BLOCKED=true
# BREAK_GLASS_DEFAULT_MAX_MINUTES=30
# ADMIN_ACTION_REQUIRE_APPROVAL=false

# Worker reliability (compose Phase 5 DB queue)
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_STALE_THRESHOLD_SECONDS=120
WORKER_MAX_RETRIES=3
IDEMPOTENCY_ENABLED=true
DLQ_ENABLED=true

# Phase 12 — Simulation, Optimization & Agent Marketplace
# -----------------------------------------------------
# Phase 12 adds NO new environment variables or settings (verified: app/core/config.py
# has no sim_*/phase12* settings). It composes Phase 11 governance knobs:
#   - Per-day resource budgets for the 8 Phase 12 categories are DB-configured via the
#     Phase 11 governance API (/governance/resources, /governance/limits):
#     sim_runs, sim_iterations, sim_events, optimization_candidates,
#     benchmark_runs, benchmark_cases, experiment_runs, marketplace_ops
#     (unlimited until an operator sets a limit; engine hard ceilings always active).
#   - Engine hard ceilings are constructor defaults, not env:
#     max_ticks=500, max_events=5000, max_iterations=50, run_timeout_seconds=60.
#   - Concurrency ceiling: MAX_CONCURRENT_PHASE12_RUNS = 8 (editable constant in
#     app/phase12/governance.py).
# The relevant Phase 11 settings that govern Phase 12 behavior are listed above
# (AUTH_ENABLED, APPROVAL_*, RESOURCE_MAX_*).

# ── Health probes (used by docker-compose healthcheck) ──────────────────────
# Unauthenticated canonical endpoints (no token required):
#   GET /api/v1/health/live          — liveness (always 200 when process up)
#   GET /api/v1/health/ready         — readiness (db + redis; 200 ok, 503 down)
#   GET /api/v1/health/dependencies  — per-dependency details
# Auth-bound equivalents also exist at /api/v1/system/health/{live,ready,dependencies}
# (they require a valid bearer token when AUTH_ENABLED=true).
