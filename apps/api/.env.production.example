# NEXUS — production-mode environment (reference only).
#
# Copy the names, not the values: this file documents the configuration the
# one-command harness (scripts/run_production.sh at the repo root) sets
# programmatically. It is NOT loaded automatically, contains placeholder
# secrets, and must never receive a real key. In a real deployment, provide
# these as real environment variables/secret-manager entries — never a
# committed file.
#
# See docs/operations.md (§Production mode & load baseline) and
# docs/security.md.

# ── Security chain (the piece production mode adds) ─────────────────────────
# Each is OFF by default so the demo and test suite stay open; production turns
# them on together.
AUTH_ENABLED=true
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true
LOGGING_JSON=true

# Real secrets: generate fresh, per deployment.
#   openssl rand -hex 32                                                  (JWT)
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=change-me-64-hex-chars
SECRET_ENCRYPTION_KEY=change-me-fernet-format-key=

# CORS: pin to the real frontend origin(s) instead of the dev allow-all.
CORS_ORIGINS=["https://app.example.com"]

# Tighter rate tiers than the dev defaults, if load warrants.
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_DEFAULT_PER_MINUTE=600
# RATE_LIMIT_EXPENSIVE_PER_MINUTE=30
# RATE_LIMIT_EXTERNAL_PER_MINUTE=60

# HTTPS terminates at the ingress; send secure cookies.
SECURE_AUTH_COOKIES=true
# Tell the app TLS terminates at the edge (Caddy via scripts/deploy.sh --tls, or
# your own LB) so the readiness `tls` gate PASSes instead of assuming plaintext.
TLS_ENABLED=true
# TRUSTED_HOSTS=["app.example.com","api.example.com"]
# ALLOWED_HOSTS=[]        # empty => TRUSTED_HOSTS governs

# ── Optional real LLM (default: deterministic, keyless) ────────────────────
# Without these the OpenAI adapters degrade to deterministic fallback and the
# platform runs fully keyless. With a key, agents configured with
# provider="openai" make real API calls metered to YOUR account.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=            # empty -> https://api.openai.com/v1
# OPENAI_DEFAULT_MODEL=gpt-4o-mini
# MEMORY_EMBEDDING_PROVIDER=  # "openai" to enable real semantic embeddings
# Model-backed startup analyzers/planners (mission analysis + strategic plan):
# needs a real key above; unset/off keeps the deterministic pipeline.
# MODEL_PLANNERS_ENABLED=true

# ── Workers (opt-in) ───────────────────────────────────────────────────────
# In-process daemon threads; default OFF (synchronous execution path used).
# WORKFLOW_WORKER_ENABLED=true
# ORCHESTRATION_WORKER_ENABLED=true

# ── Governance: tenant resource limits ─────────────────────────────────────
# Seed resource_limit rows at startup from the resource_max_* ceilings: 5 core
# categories + 8 Phase 12 categories, global + one per-company row. Idempotent;
# tenants can lower their own caps via the governance API afterwards. Off by
# default so dev/tests start unlimited — enable for real deployments.
RESOURCE_LIMITS_PROVISION=true
# RESOURCE_MAX_PHASE12_DEFAULT=1000   # shared per-day cap for Phase 12 categories

# ── Platform ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://nexus:nexus_dev@localhost:5433/nexus
ENVIRONMENT=production

# Bootstrap admin — DEVELOP ONLY. Real production must NOT set these (the
# production-readiness check FAILs if it finds them); use the seeding script
# or identity provisioning instead.
# AUTH_DEV_BOOTSTRAP_EMAIL=admin@example.com
# AUTH_DEV_BOOTSTRAP_PASSWORD=ephemeral-super-secret