{
  "title": "NEXUS Platform",
  "uid": "nexus-platform",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["nexus"],
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(request_total[5m]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(request_error_total[5m]))",
          "legendFormat": "errors/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Avg request latency (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(request_milliseconds_sum[5m]) / rate(request_milliseconds_count[5m])",
          "legendFormat": "avg ms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [{ "expr": "queue_depth", "legendFormat": "depth", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "max": 100, "min": 0 },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Token usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(model_tokens_input_total[5m]))",
          "legendFormat": "input tokens/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(model_tokens_output_total[5m]))",
          "legendFormat": "output tokens/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Process uptime (h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "time() - nexus_process_started_at",
          "legendFormat": "uptime s",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "h" }, "overrides": [] }
    }
  ]
}